# Registry Server Configuration
# Copy this file to .env and adjust values for your environment

# Server Port
PORT=3000

# Database URL (local SQLite for development)
# For production, set to postgres://user:pass@host:5432/dbname
DATABASE_URL=/app/data/registry.db

# Admin Access (for creating admin users)
# ADMIN_KEY=your-secret-admin-key-here

# CORS & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5050

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_CONTACT_FORM=true
