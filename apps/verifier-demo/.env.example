# Verifier Demo Configuration
# Copy this file to .env.local for Vite frontend variables
# Copy to .env for Node.js backend variables

# Vite Frontend Variables (prefixed with VITE_)
VITE_VERIFIER_ORIGIN=http://localhost:5174
VITE_REGISTRY_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:5050

# Node.js Backend Variables
PORT=5050
VERIFIER_ORIGIN=http://localhost:5174
REGISTRY_URL=http://registry:3000

# For Docker environment, use service name; for local dev, use localhost
# Note: Change REGISTRY_URL to http://localhost:3000 when running locally
