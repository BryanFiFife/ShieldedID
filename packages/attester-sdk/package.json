{
  "name": "@shielded-id/attester-sdk",
  "version": "1.5.0",
  "description": "Shielded ID attester SDK for issuer-signed commitment credentials",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/attester.js",
  "module": "./dist/attester.js",
  "types": "./dist/attester.d.ts",
  "exports": {
    ".": {
      "types": "./dist/attester.d.ts",
      "import": "./dist/attester.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@shielded-id/age-zk": "workspace:*",
    "axios": "^1.18.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^1.4.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  }
}
