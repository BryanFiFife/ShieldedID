{
  "name": "@shielded-id/verifier-sdk",
  "version": "1.6.1",
  "description": "Shielded ID verifier SDK",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "example": "tsx examples/quickstart.ts",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@shielded-id/age-zk": "workspace:*",
    "axios": "^1.18.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
