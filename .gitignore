# Dependencies
node_modules/
.pnpm/
.pnpm-debug.log

# Build outputs
dist/
dist-cjs/
dist-*/
build/
out/
*.tsbuildinfo
*.js
*.jsx
!src/**/*.js
!public/**/*.js
# Compiled WASM glue is committed on purpose (packages/age-zk/pkg/) so
# consumers resolve the entry point without a Rust toolchain:
!packages/age-zk/pkg/**/*.js
!packages/age-zk/pkg/**/*.wasm

# Rust
target/
Cargo.lock  # if not needed, but usually tracked

# Binaries
*.exe
*.dll
*.so
*.dylib
*.wasm

