# Root Environment Configuration
# This is a reference file showing all services' environment variables

# === REGISTRY SERVER (apps/registry-server) ===
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shielded_id
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shielded_id
DB_SSL=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5050,http://localhost:3001
LOG_LEVEL=info

# === WALLET PWA (apps/wallet-pwa) ===
VITE_REGISTRY_URL=http://localhost:3000

# === VERIFIER DEMO (apps/verifier-demo) ===
VITE_VERIFIER_ORIGIN=http://localhost:5174
VITE_REGISTRY_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:5050
VERIFIER_ORIGIN=http://localhost:5174
REGISTRY_URL=http://localhost:3000

# === OBSERVABILITY ===
PROMETHEUS_PORT=9090
ENABLE_PROMETHEUS=true

# === FEATURE FLAGS ===
ENABLE_CONTINUOUS_AUTH=true
ENABLE_OFFLINE_MODE=true
SESSION_TTL_MS=3600000

# === ADVANCED ===
NODE_ENV=development
